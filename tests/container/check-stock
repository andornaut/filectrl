#!/usr/bin/env bash
set -euo pipefail
checkout=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
# shellcheck source=tests/container/stock
source "${checkout}/tests/container/stock"
action=${1:-check}
shift || true
case "${action}" in check|lint|test|build) ;; *) exit 2 ;; esac
stock_begin "${checkout}"
STOCK_NETWORK=bridge stock_run "${FILECTRL_TEST_IMAGE:-rust:1.98}" -- sh tests/container/rust "${action}" "$@"
if [[ ${action} == check || ${action} == lint ]]; then
    STOCK_NETWORK=bridge stock_run node:24.22.2 -- sh tests/container/markdown
    stock_readonly koalaman/shellcheck:v0.11.0 /bin/shellcheck -x -P SCRIPTDIR tests/container/stock tests/container/check-stock tests/container/rust tests/container/markdown tests/native/run tests/native/check scripts/test-in-container .cargo-husky/hooks/pre-commit
fi
stock_finish
